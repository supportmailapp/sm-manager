{
  "compilerOptions": {
    "module": "esnext",
    "target": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true
  },
  "include": ["**/*.ts", ".vitepress/**/*.ts"],
  "exclude": ["**/node_modules/**", "**/dist/**"]
}
